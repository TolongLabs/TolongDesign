# Graphify ignore — heavy/binary files with no extractable knowledge.
# Syntax follows .gitignore rules. (.gitignore itself is already respected,
# so node_modules/, dist/, .env etc. need no repeating here — listed anyway
# where harmless for clarity.)

# Raster + vector images (brand marks, heroes, favicons — presentational)
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.avif
*.bmp
*.tif
*.tiff
*.ico
*.svg

# Video + audio
*.mp4
*.webm
*.mov
*.avi
*.mkv
*.m4v
*.mp3
*.wav
*.ogg
*.flac
*.m4a
*.aac

# Binary documents (PDFs, Office formats)
*.pdf
*.doc
*.docx
*.ppt
*.pptx
*.xls
*.xlsx
*.odt
*.ods
*.odp

# Fonts
*.woff
*.woff2
*.ttf
*.otf
*.eot

# Archives, packages, binaries
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz
*.7z
*.rar
*.exe
*.dll
*.so
*.dylib
*.bin
*.dat
*.wasm

# Data stores / dumps
*.parquet
*.db
*.sqlite
*.sqlite3
*.dump

# Python bytecode — compiled build artefacts
__pycache__/
*.py[cod]

# Generated lockfiles — noise, not knowledge
bun.lock
bun.lockb
package-lock.json
yarn.lock
pnpm-lock.yaml
skills-lock.json

# Character cards are creative configuration, not repository knowledge: the
# validator and the loading path (server/src/character/) explain how they work,
# so indexing the personas themselves only adds noise to the graph.
**/characters/*.json

# Vendored agent tooling — installed skill copies, not project knowledge
# (same category as node_modules for graph purposes)
# .codex/ stays IN: its hooks.json is the only record of how this repo wires
# agent hooks, which is project knowledge, unlike the installed skill trees.
.agents/
.claude/

# Graphify's own output (don't index the graph into itself)
graphify-out/
