{
  "name": "tolong-design",
  "version": "0.1.2",
  "private": true,
  "engines": {
    "bun": ">=1.4.0"
  },
  "type": "module",
  "description": "TolongLabs' private design starting point: one agent-friendly doc per curated design tool.",
  "scripts": {
    "check": "bun scripts/check-docs.ts",
    "index": "bun scripts/build-index.ts && prettier --log-level warn --write docs/design/README.md 'docs/design/*/README.md' docs/design/people.md",
    "find": "bun scripts/find.ts",
    "design": "bun scripts/design.ts",
    "build:release": "bun scripts/prepare-release.ts",
    "smoke:release": "bun scripts/smoke-release.ts",
    "test": "bun test",
    "format": "prettier --write \"**/*.{md,json,ts}\"",
    "format:check": "prettier --check \"**/*.{md,json,ts}\"",
    "links": "bun scripts/check-links.ts",
    "line-art:demo": "bun collections/line-art/demo/index.html",
    "line-art:previews": "bun collections/line-art/scripts/previews.ts",
    "line-art:typecheck": "tsc -p collections/line-art/tsconfig.json",
    "agent-video:install": "bun install --cwd collections/agent-video",
    "agent-video:studio": "cd collections/agent-video && bunx remotion studio src/index.ts",
    "agent-video:render": "cd collections/agent-video && bunx remotion render src/index.ts",
    "agent-video:previews": "cd collections/agent-video && bun scripts/previews.ts",
    "agent-video:knowledge": "bun collections/agent-video/scripts/knowledge-index.ts",
    "agent-video:typecheck": "tsc -p collections/agent-video/tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "prettier": "^3.9.9",
    "typescript": "5.9.3",
    "yaml": "^2.9.1"
  }
}
