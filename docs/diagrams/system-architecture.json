  "cards": [
    {
      "dot": "cyan",
      "title": "No retrieval service",
      "items": [
        "No network request or target-project write on the retrieval path.",
        "Ranker and context builder receive in-memory resources; the loader owns file reads.",
        "The MCP server is the same read-only core behind stdio; it adds no second data path."
      ]
    },
    {
      "dot": "slate",
      "title": "Separate maintenance paths",
      "items": [
        "The generated index and knowledge graph are derived views, not runtime search authorities.",
        "Link checks, indexing, doctor and release operations have separate documented paths."
      ]
    }
  ]
